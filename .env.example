# Environment Variables Example Template
# Copy this file to .env and replace placeholder values with your actual configuration.

# PostgreSQL Connection URL
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/image_relevance_auto_tagging

# Google Gemini API Key
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
